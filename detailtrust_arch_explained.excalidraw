      "versionNonce": 10029,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791892185055,
      "link": null,
      "locked": false,
      "text": "The first guess is kept as the starting point.\nDetail branches propose changes to the three\nforeground scores, not a replacement map.\n\nA missing modality contributes no edit.\nShared weights are reused for all four scans.",
      "originalText": "The first guess is kept as the starting point.\nDetail branches propose changes to the three\nforeground scores, not a replacement map.\n\nA missing modality contributes no edit.\nShared weights are reused for all four scans.",
