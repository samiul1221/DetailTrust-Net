      "text": "5  Decide how much of each edit to use",
      "originalText": "5  Decide how much of each edit to use",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
