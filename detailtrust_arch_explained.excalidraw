      "boundElements": [],
      "updated": 1791892185055,
      "link": null,
      "locked": false,
      "text": "Train U-Net, mixture\nand the shared refiner.\nGates are fixed at 1.\nDrop edits with p = 0.25.\n\nFinal loss + 0.3 base loss\n+ 0.1 one-branch loss.",
      "originalText": "Train U-Net, mixture\nand the shared refiner.\nGates are fixed at 1.\nDrop edits with p = 0.25.\n\nFinal loss + 0.3 base loss\n+ 0.1 one-branch loss.",
