      "updated": 1791892185055,
      "link": null,
      "locked": false,
      "text": "A 3D residual U-Net reads the four smooth\nimages plus four availability maps.\n\nIt outputs two things:\n• Base scores z₀ for four tissue classes.\n• Context F: 32 learned feature channels.\n\nFive levels: 32 → 64 → 128 → 256 → 320.",
      "originalText": "A 3D residual U-Net reads the four smooth\nimages plus four availability maps.\n\nIt outputs two things:\n• Base scores z₀ for four tissue classes.\n• Context F: 32 learned feature channels.\n\nFive levels: 32 → 64 → 128 → 256 → 320.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
