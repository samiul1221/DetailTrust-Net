    {
      "id": "detailtrust-54",
      "type": "text",
      "x": 834,
      "y": 1704,
      "width": 325,
      "height": 172,
      "angle": 0,
      "strokeColor": "#24354b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1054,
      "version": 1,
      "versionNonce": 10054,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791892185055,
      "link": null,
      "locked": false,
      "text": "Freeze U-Net and refiner\n(and smoothing mixture).\nRemove one candidate edit:\ndoes voxelwise CE worsen?\nIf yes, favour that edit.\n\nSegmentation + 0.1 utility BCE.",
      "originalText": "Freeze U-Net and refiner\n(and smoothing mixture).\nRemove one candidate edit:\ndoes voxelwise CE worsen?\nIf yes, favour that edit.\n\nSegmentation + 0.1 utility BCE.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "detailtrust-55",
      "type": "text",
      "x": 25,
      "y": 1900,
      "width": 1150,
      "height": 55,
      "angle": 0,
      "strokeColor": "#24354b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1055,
      "version": 1,
      "versionNonce": 10055,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791892185055,
      "link": null,
      "locked": false,
      "text": "Utility target: compare all ungated edits with one removed; average the CE change over 3³ neighbours,\napply sigmoid(change / 0.1), detach it, and supervise available gates with balanced tumour/background BCE.",
      "originalText": "Utility target: compare all ungated edits with one removed; average the CE change over 3³ neighbours,\napply sigmoid(change / 0.1), detach it, and supervise available gates with balanced tumour/background BCE.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "detailtrust-56",
      "type": "text",
      "x": 25,
      "y": 1970,
      "width": 1150,
      "height": 58,
      "angle": 0,
      "strokeColor": "#24354b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1056,
      "version": 1,
      "versionNonce": 10056,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791892185055,
      "link": null,
      "locked": false,
      "text": "CE = cross-entropy: penalizes wrong class scores. Dice = overlap of prediction and reference.\nBCE = binary cross-entropy: fits the gate to its soft utility target. Lower loss is better.",
      "originalText": "CE = cross-entropy: penalizes wrong class scores. Dice = overlap of prediction and reference.\nBCE = binary cross-entropy: fits the gate to its soft utility target. Lower loss is better.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "detailtrust-57",
      "type": "text",
      "x": 25,
      "y": 2040,
      "width": 1150,
      "height": 55,
      "angle": 0,
      "strokeColor": "#24354b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1057,
      "version": 1,
      "versionNonce": 10057,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791892185055,
      "link": null,
      "locked": false,
      "text": "Layer widths: shared refiner 37→16→16→3; shared gate 44→16→16→1 (middle layer is depthwise).\nThis explains the proposed design; it does not show a measured improvement or calibrated certainty.",
      "originalText": "Layer widths: shared refiner 37→16→16→3; shared gate 44→16→16→1 (middle layer is depthwise).\nThis explains the proposed design; it does not show a measured improvement or calibrated certainty.",
