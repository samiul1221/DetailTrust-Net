: "solid", "roughness": 0, "opacity": 100, "groupIds": ["gL"], "frameId": null, "roundness": null, "seed": 899822596, "version": 1, "versionNonce": 1791420123, "isDeleted": false, "boundElements": null, "updated": 1760000000000, "link": null, "locked": false, "text": "a", "fontSize": 14, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "lgC", "originalText": "a", "autoResize": true, "lineHeight": 1.25}, {"id": "lgCT", "type": "text", "x": 2176, "y": 66, "width": 185.6, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["gL"], "frameId": null, "roundness": null, "seed": 281478590, "version": 1, "versionNonce": 130791459, "isDeleted": false, "boundElements": null, "updated": 1760000000000, "link": null, "locked": false, "text": "Reused signal (a, e)", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Reused signal (a, e)", "autoResize": true, "lineHeight": 1.25}, {"id": "zG", "type": "rectangle", "x": 30, "y": 810, "width": 710, "height": 268, "angle": 0, "strokeColor": "#f59f00", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["gG"], "frameId": null, "roundness": {"type": 3}, "seed": 1954246751, "version": 1, "versionNonce": 1588970510, "isDeleted": false, "boundElements": [], "updated": 1760000000000, "link": null, "locked": false}, {"id": "gT0", "type": "text", "x": 44, "y": 820, "width": 292.32, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["gG"], "frameId": null, "roundness": null, "seed": 759745401, "version": 1, "versionNonce": 1927804670, "isDeleted": false, "boundElements": null, "updated": 1760000000000, "link": null, "locked": false, "text": "Why this design is different", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Why this design is different", "autoResize": true, "lineHeight": 1.25}, {"id": "gB0", "type": "text", "x": 44, "y": 850, "width": 668.16, "height": 220.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["gG"], "frameId": null, "roundness": null, "seed": 983893223, "version": 1, "versionNonce": 1422653865, "isDeleted": false, "boundElements": null, "updated": 1760000000000, "link": null, "locked": false, "text": "• The U-Net sees only smoothed images L (plus flags a) → base scores z₀.\n• A small shared net R reads the detail H_m of each scan and proposes\n  score changes r_m. R subtracts its own zero-detail output, so r_m = 0\n  when H_m = 0: changes are attributable to the detail, not a second\n  segmentation made from context.\n• A spatial gate q_m decides how much of each proposal to add. Final\n  scores = z₀ + retained corrections, with no later layers, so every\n  correction can be shown or removed exactly.\n• 'Low-pass' and 'detail' are intuitions, not a clean split of anatomy,\n  noise and edges: H also holds noise and skull-strip edges. Only the\n  detail refinement is inspectable, not the whole U-Net.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• The U-Net sees only smoothed images L (plus flags a) → base scores z₀.\n• A small shared net R reads the detail H_m of each scan and proposes\n  score changes r_m. R subtracts its own zero-detail output, so r_m = 0\n  when H_m = 0: changes are attributable to the detail, not a second\n  segmentation made from context.\n• A spatial gate q_m decides how much of each proposal to add. Final\n  scores = z₀ + retained corrections, with no later layers, so every\n  correction can be shown or removed exactly.\n• 'Low-pass' and 'detail' are intuitions, not a clean split of anatomy,\n  noise and edges: H also holds noise and skull-strip edges. Only the\n  detail refinement is inspectable, not the whole U-Net.", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}